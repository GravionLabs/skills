{
  "name": "gravionlabs-skills-tools",
  "version": "1.0.0",
  "packageManager": "pnpm@12.22.0",
  "description": "Checks, docs generator and tests for the GravionLabs skills",
  "scripts": {
    "generate": "node scripts/generate-skill-list.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check && oxlint",
    "check": "pnpm run format:check && node scripts/check-marketplace.mjs && pwsh skills/skill-tooling/skill-slim/scripts/Get-SkillReport.ps1 -Root . -FailOnDangling && pnpm run lint:ps && pnpm run typecheck && pnpm test",
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "check:changed": "node scripts/check-changed.mts",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p test --noEmit",
    "lint": "oxlint",
    "lint:ps": "pwsh scripts/Invoke-ScriptAnalysis.ps1"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.2",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
