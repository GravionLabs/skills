{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "test/skills/delivery/agent-events",
    "**/node_modules",
    "**/coverage",
    "**/test-results",
    "pnpm-lock.yaml",
    ".worktrees",
    ".work",
    "site/skill-list.md",
    "CHANGELOG.md",
    "site/.vitepress/cache",
    "site/.vitepress/dist",
    "skills/**/templates/**",
    "skills/**/assets/**",
    ".claude-plugin/marketplace.json",
    "skills/delivery/skills-manage/scripts/groups.json",
    ".agents/**"
  ],
  "endOfLine": "lf",
  "sortPackageJson": false
}
