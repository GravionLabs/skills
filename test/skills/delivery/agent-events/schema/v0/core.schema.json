{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravionlabs.github.io/agent-events/schema/v0/core.schema.json",
  "title": "agent-events core event",
  "description": "One line of a run file. Unknown fields, unknown types and prefixed profile fields stay valid. Rules across lines (gapless seq, line length, incomplete last line) are in SPEC.md.",
  "type": "object",
  "required": ["v", "seq", "ts", "run", "type", "tone"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "run": { "$ref": "#/$defs/runId" },
    "type": { "type": "string", "minLength": 1 },
    "tone": { "enum": ["neutral", "info", "success", "warning", "danger"] },
    "needsYou": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "run.started" } }, "required": ["type"] },
      "then": {
        "required": ["profiles", "host"],
        "properties": {
          "profiles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*@[0-9]+$" } },
          "profileSchemas": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9-]*@[0-9]+$" },
            "additionalProperties": { "type": "string", "format": "uri", "pattern": "^https://" }
          },
          "host": { "$ref": "#/$defs/host" },
          "agent": { "type": "object", "properties": { "harness": { "type": "string" }, "model": { "type": "string" } } },
          "subject": { "$ref": "#/$defs/subject" }
        } } },
    { "if": { "properties": { "type": { "const": "run.finished" } }, "required": ["type"] },
      "then": {
        "required": ["outcome"],
        "properties": {
          "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
          "reason": { "$ref": "#/$defs/reason" },
          "text": { "$ref": "#/$defs/text" }
        } } },
    { "if": { "properties": { "type": { "const": "task.started" } }, "required": ["type"] },
      "then": {
        "required": ["task", "subject"],
        "properties": {
          "task": { "$ref": "#/$defs/id" },
          "parent": { "$ref": "#/$defs/id" },
          "subject": { "$ref": "#/$defs/subject" }
        } } },
    { "if": { "properties": { "type": { "const": "task.finished" } }, "required": ["type"] },
      "then": {
        "required": ["task", "outcome"],
        "properties": {
          "task": { "$ref": "#/$defs/id" },
          "outcome": { "enum": ["succeeded", "failed", "cancelled", "skipped"] },
          "reason": { "$ref": "#/$defs/reason" },
          "text": { "$ref": "#/$defs/text" }
        } } },
    { "if": { "properties": { "type": { "const": "step.started" } }, "required": ["type"] },
      "then": {
        "required": ["step"],
        "properties": { "task": { "$ref": "#/$defs/id" }, "step": { "$ref": "#/$defs/step" } } } },
    { "if": { "properties": { "type": { "const": "step.finished" } }, "required": ["type"] },
      "then": {
        "required": ["step"],
        "properties": {
          "task": { "$ref": "#/$defs/id" },
          "step": { "$ref": "#/$defs/step" },
          "links": { "$ref": "#/$defs/links" }
        } } },
    { "if": { "properties": { "type": { "const": "progress" } }, "required": ["type"] },
      "then": {
        "required": ["done", "total"],
        "properties": {
          "task": { "$ref": "#/$defs/id" },
          "done": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "label": { "type": "string" }
        } } },
    { "if": { "properties": { "type": { "const": "attention" } }, "required": ["type"] },
      "then": {
        "required": ["id", "reason", "needsYou"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "task": { "$ref": "#/$defs/id" },
          "reason": { "$ref": "#/$defs/reason" },
          "text": { "$ref": "#/$defs/text" },
          "needsYou": { "type": "boolean" },
          "links": { "$ref": "#/$defs/links" }
        } } },
    { "if": { "properties": { "type": { "const": "attention.resolved" } }, "required": ["type"] },
      "then": { "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" } } } }
  ],
  "$defs": {
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "description": "also the file name <run>.jsonl" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reason": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "description": "machine-readable code; profile reasons are prefixed <profile>." },
    "text": { "type": "string", "minLength": 1, "description": "the human sentence for the reason" },
    "subject": {
      "type": "object",
      "required": ["kind", "id", "title"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "url"],
        "properties": {
          "rel": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "n": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9._-]+$" },
      "additionalProperties": { "type": "string" }
    }
  }
}
