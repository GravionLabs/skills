{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravionlabs.github.io/agent-events/schema/v0/run-state.schema.json",
  "title": "agent-events core run state",
  "description": "The fold of the events of one run. Folding rules are in SPEC.md. Profiles extend this object under their own name.",
  "type": "object",
  "required": ["v", "run", "status", "tasks", "finished", "attentions", "needsYou", "links", "gaps", "lastSeq"],
  "properties": {
    "v": { "const": 1 },
    "run": { "type": "string" },
    "status": { "enum": ["running", "finished", "abandoned"] },
    "outcome": { "enum": ["succeeded", "failed", "cancelled"], "description": "only when status is finished" },
    "reason": { "type": "string" },
    "text": { "type": "string" },
    "subject": { "$ref": "#/$defs/subject", "description": "subject of run.started" },
    "progress": { "$ref": "#/$defs/progress", "description": "latest progress without task: progress of the run subject" },
    "step": { "$ref": "#/$defs/step", "description": "last step.started or step.finished without task: step of the run" },
    "tasks": { "type": "array", "description": "open tasks in start order", "items": { "$ref": "#/$defs/openTask" } },
    "finished": {
      "type": "object",
      "description": "finished tasks per outcome, in finish order",
      "required": ["succeeded", "failed", "cancelled", "skipped"],
      "properties": {
        "succeeded": { "$ref": "#/$defs/finishedTasks" },
        "failed": { "$ref": "#/$defs/finishedTasks" },
        "cancelled": { "$ref": "#/$defs/finishedTasks" },
        "skipped": { "$ref": "#/$defs/finishedTasks" }
      }
    },
    "attentions": { "type": "array", "description": "open attentions in raise order", "items": { "$ref": "#/$defs/attention" } },
    "needsYou": { "type": "boolean", "description": "true when an open attention has needsYou true" },
    "links": { "$ref": "#/$defs/links", "description": "links of step.finished and attention events, first occurrence of rel+url" },
    "gaps": {
      "type": "array",
      "description": "missing seq ranges, inclusive",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } }
      }
    },
    "lastSeq": { "type": "integer", "minimum": 0 },
    "updated": { "type": "string", "format": "date-time", "description": "ts of the last folded event" }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["kind", "id", "title"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "url"],
        "properties": { "rel": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "title": { "type": "string" } }
      }
    },
    "progress": {
      "type": "object",
      "required": ["done", "total"],
      "properties": {
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "n": { "type": "integer" },
        "total": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "openTask": {
      "type": "object",
      "required": ["task", "subject"],
      "properties": {
        "task": { "type": "string" },
        "parent": { "type": "string" },
        "subject": { "$ref": "#/$defs/subject" },
        "step": { "$ref": "#/$defs/step", "description": "last step.started or step.finished of the task" },
        "progress": { "$ref": "#/$defs/progress" },
        "links": { "$ref": "#/$defs/links" }
      }
    },
    "finishedTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "subject"],
        "properties": {
          "task": { "type": "string" },
          "parent": { "type": "string" },
          "subject": { "$ref": "#/$defs/subject" },
          "reason": { "type": "string" },
          "text": { "type": "string" },
          "links": { "$ref": "#/$defs/links" }
        }
      }
    },
    "attention": {
      "type": "object",
      "required": ["id", "reason", "needsYou"],
      "properties": {
        "id": { "type": "string" },
        "task": { "type": "string" },
        "reason": { "type": "string" },
        "text": { "type": "string" },
        "needsYou": { "type": "boolean" },
        "links": { "$ref": "#/$defs/links" }
      }
    }
  }
}
