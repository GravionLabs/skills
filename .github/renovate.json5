// Renovate keeps the npm packages (root and site/, one pnpm lockfile) and the GitHub Actions current: a few grouped pull
// requests a week against release/next, gated by CI, merged by a person (no automerge).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // github>GravionLabs/ci: 7 days minimum release age (security fixes exempt), actions pinned to commit SHAs.
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':dependencyDashboard',
    'github>GravionLabs/ci',
  ],
  baseBranchPatterns: ['release/next'],
  // `chore(deps): ...` keeps dependency updates out of the release notes.
  // Issue titles start with their level (AGENTS.md): the dashboard is a PBI.
  dependencyDashboard: true,
  dependencyDashboardTitle: '[PBI] chore: Dependency Dashboard',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  timezone: 'Europe/Zurich',
  schedule: ['before 6am on monday'],
  lockFileMaintenance: { enabled: true, schedule: ['before 6am on the first day of the month'] },
  // Raise the range in package.json to the new version instead of leaving it as it was.
  rangeStrategy: 'bump',
  automerge: false,
  labels: ['dependencies'],
  enabledManagers: ['npm', 'github-actions'],
  // The manifests and workflows under skills/ are templates a skill copies into another repository, not installed
  // code: they are changed by hand, with their skill.
  ignorePaths: ['skills/**', '**/node_modules/**'],
  // A known vulnerability gets a pull request at once, outside the schedule.
  vulnerabilityAlerts: { enabled: true, labels: ['security'], schedule: ['at any time'] },
  osvVulnerabilityAlerts: true,
  packageRules: [
    { groupName: 'vitest', matchPackageNames: ['vitest', '@vitest/**'] },
    {
      // The site: VitePress and its Mermaid plugin move together.
      groupName: 'vitepress',
      matchPackageNames: ['vitepress', 'vitepress-plugin-mermaid', 'mermaid'],
    },
    {
      // Workflows follow the major tag of the shared workflows on purpose (test/repo/ci-major-tag.test.ts): no digest
      // pin from the preset.
      matchManagers: ['github-actions'],
      matchPackageNames: ['GravionLabs/ci', 'GravionLabs/ci/**'],
      pinDigests: false,
    },
    {
      // And no pull request for a new major of them: a person raises @v1.
      matchManagers: ['github-actions'],
      matchPackageNames: ['GravionLabs/ci', 'GravionLabs/ci/**'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // Majors get their own pull requests, labelled, and a person decides.
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
  ],
}
